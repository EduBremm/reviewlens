{
    "openapi": "3.1.0",
    "info": {
        "title": "ReviewLens API",
        "description": "Minera\u00e7\u00e3o de sentimentos em reviews de aplicativos (tema 9).",
        "version": "1.0.0"
    },
    "paths": {
        "/health": {
            "get": {
                "summary": "Health",
                "operationId": "health_health_get",
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    }
                }
            }
        },
        "/model/info": {
            "get": {
                "summary": "Model Info",
                "operationId": "model_info_model_info_get",
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    }
                }
            }
        },
        "/predict": {
            "post": {
                "summary": "Predict",
                "operationId": "predict_predict_post",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ReviewIn"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PredictionOut"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/predict/batch": {
            "post": {
                "summary": "Predict Batch",
                "operationId": "predict_batch_predict_batch_post",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/BatchIn"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/BatchOut"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/predictions": {
            "get": {
                "summary": "Predictions",
                "operationId": "predictions_predictions_get",
                "parameters": [
                    {
                        "name": "limit",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "maximum": 1000,
                            "minimum": 1,
                            "default": 50,
                            "title": "Limit"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/apps": {
            "get": {
                "summary": "List Apps",
                "operationId": "list_apps_apps_get",
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    }
                }
            }
        },
        "/insights/summary": {
            "get": {
                "summary": "Ins Summary",
                "operationId": "ins_summary_insights_summary_get",
                "parameters": [
                    {
                        "name": "app",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "title": "App"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/insights/timeline": {
            "get": {
                "summary": "Ins Timeline",
                "operationId": "ins_timeline_insights_timeline_get",
                "parameters": [
                    {
                        "name": "app",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "title": "App"
                        }
                    },
                    {
                        "name": "since",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "default": "2019-01",
                            "title": "Since"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/insights/versions": {
            "get": {
                "summary": "Ins Versions",
                "operationId": "ins_versions_insights_versions_get",
                "parameters": [
                    {
                        "name": "app",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "title": "App"
                        }
                    },
                    {
                        "name": "min_reviews",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "default": 20,
                            "title": "Min Reviews"
                        }
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "maximum": 200,
                            "minimum": 1,
                            "default": 15,
                            "title": "Limit"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/insights/complaints": {
            "get": {
                "summary": "Ins Complaints",
                "operationId": "ins_complaints_insights_complaints_get",
                "parameters": [
                    {
                        "name": "app",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "title": "App"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/insights/terms": {
            "get": {
                "summary": "Ins Terms",
                "operationId": "ins_terms_insights_terms_get",
                "parameters": [
                    {
                        "name": "app",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "title": "App"
                        }
                    },
                    {
                        "name": "label",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "default": "NEGATIVO",
                            "title": "Label"
                        }
                    },
                    {
                        "name": "k",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "maximum": 100,
                            "default": 25,
                            "title": "K"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "BatchIn": {
                "properties": {
                    "reviews": {
                        "items": {
                            "$ref": "#/components/schemas/ReviewIn"
                        },
                        "type": "array",
                        "maxItems": 500,
                        "minItems": 1,
                        "title": "Reviews"
                    }
                },
                "type": "object",
                "required": [
                    "reviews"
                ],
                "title": "BatchIn"
            },
            "BatchOut": {
                "properties": {
                    "n": {
                        "type": "integer",
                        "title": "N"
                    },
                    "distribuicao": {
                        "additionalProperties": {
                            "type": "integer"
                        },
                        "type": "object",
                        "title": "Distribuicao"
                    },
                    "resultados": {
                        "items": {
                            "$ref": "#/components/schemas/PredictionOut"
                        },
                        "type": "array",
                        "title": "Resultados"
                    }
                },
                "type": "object",
                "required": [
                    "n",
                    "distribuicao",
                    "resultados"
                ],
                "title": "BatchOut"
            },
            "HTTPValidationError": {
                "properties": {
                    "detail": {
                        "items": {
                            "$ref": "#/components/schemas/ValidationError"
                        },
                        "type": "array",
                        "title": "Detail"
                    }
                },
                "type": "object",
                "title": "HTTPValidationError"
            },
            "PredictionOut": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "Id"
                    },
                    "sentimento": {
                        "type": "string",
                        "title": "Sentimento"
                    },
                    "probabilidades": {
                        "$ref": "#/components/schemas/Probabilities"
                    },
                    "confianca": {
                        "type": "number",
                        "title": "Confianca"
                    },
                    "alerta_negativo": {
                        "type": "boolean",
                        "title": "Alerta Negativo"
                    },
                    "grupo_reclamacao": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Grupo Reclamacao"
                    },
                    "termos_influentes": {
                        "items": {
                            "type": "string"
                        },
                        "type": "array",
                        "title": "Termos Influentes"
                    },
                    "model_version": {
                        "type": "string",
                        "title": "Model Version"
                    }
                },
                "type": "object",
                "required": [
                    "id",
                    "sentimento",
                    "probabilidades",
                    "confianca",
                    "alerta_negativo",
                    "termos_influentes",
                    "model_version"
                ],
                "title": "PredictionOut"
            },
            "Probabilities": {
                "properties": {
                    "NEGATIVO": {
                        "type": "number",
                        "title": "Negativo"
                    },
                    "NEUTRO": {
                        "type": "number",
                        "title": "Neutro"
                    },
                    "POSITIVO": {
                        "type": "number",
                        "title": "Positivo"
                    }
                },
                "type": "object",
                "required": [
                    "NEGATIVO",
                    "NEUTRO",
                    "POSITIVO"
                ],
                "title": "Probabilities"
            },
            "ReviewIn": {
                "properties": {
                    "text": {
                        "type": "string",
                        "maxLength": 5000,
                        "minLength": 1,
                        "title": "Text",
                        "examples": [
                            "The app crashes every time I open it"
                        ]
                    },
                    "app": {
                        "anyOf": [
                            {
                                "type": "string",
                                "maxLength": 100
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "App",
                        "examples": [
                            "todoist"
                        ]
                    }
                },
                "type": "object",
                "required": [
                    "text"
                ],
                "title": "ReviewIn"
            },
            "ValidationError": {
                "properties": {
                    "loc": {
                        "items": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "integer"
                                }
                            ]
                        },
                        "type": "array",
                        "title": "Location"
                    },
                    "msg": {
                        "type": "string",
                        "title": "Message"
                    },
                    "type": {
                        "type": "string",
                        "title": "Error Type"
                    },
                    "input": {
                        "title": "Input"
                    },
                    "ctx": {
                        "type": "object",
                        "title": "Context"
                    }
                },
                "type": "object",
                "required": [
                    "loc",
                    "msg",
                    "type"
                ],
                "title": "ValidationError"
            }
        }
    }
}
